{
  "expo": {
    "name": "شو نلعب؟",
    "slug": "sho-nel3b",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "shonel3b",
    "icon": "./assets/Warm retro Arabic-only game logo.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF0CF",
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-screen-orientation",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "نحتاج إلى الكاميرا لمسح رمز الغرفة",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.arabiccodenames.game",
      "icon": "./assets/Warm retro Arabic-only game logo.png",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ar",
        "NSCameraUsageDescription": "نحتاج إلى الكاميرا لمسح رمز الغرفة"
      }
    },
    "android": {
      "package": "com.arabiccodenames.game",
      "adaptiveIcon": {
        "backgroundColor": "#351326",
        "foregroundImage": "./assets/Warm retro Arabic-only game logo.png"
      },
      "permissions": [
        "CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "shonel3b",
              "host": "join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "codenames",
              "host": "join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/Warm retro Arabic-only game logo.png",
      "name": "شو نلعب؟",
      "shortName": "شو نلعب",
      "description": "ألعاب جماعية أونلاين مع الأصحاب في غرفة واحدة",
      "lang": "ar",
      "dir": "rtl",
      "display": "standalone",
      "startUrl": ".",
      "scope": ".",
      "orientation": "any",
      "themeColor": "#351326",
      "backgroundColor": "#FFF0CF",
      "barStyle": "black-translucent",
      "preferRelatedApplications": false,
      "splash": {
        "image": "./assets/Warm retro Arabic-only game logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFF0CF"
      }
    }
  }
}
